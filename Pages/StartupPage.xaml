<UserControl x:Class="Atomic.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Atomic.Core">
    <UserControl.Resources>
        <DataTemplate x:Key="StartupRow">
            <Border Style="{StaticResource Card}" Padding="18,13" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentSoft2}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1">
                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" Foreground="{StaticResource Accent2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Command}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Command}"/>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="9" Padding="9,4" Background="#12FFFFFF" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{Binding Source}" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="State" Text="{l:T Off}" Width="34" TextAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggle_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="True">
                    <Setter TargetName="State" Property="Text" Value="{l:T On}"/>
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Green}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,20,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,6,16">
            <StackPanel>
                <TextBlock x:Name="SubTitle" Style="{StaticResource MutedText}" FontSize="11.5"/>
                <TextBlock Text="{l:U 'Startup Apps'}" Style="{StaticResource H1}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="{l:T 'Task Manager'}" Style="{StaticResource GhostBtn}" Margin="0,0,10,0" Click="TaskMgr_Click"/>
                <Button Content="&#xE72C;" Style="{StaticResource IconBtn}" ToolTip="{l:T Reload}" Click="Reload_Click"/>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <ItemsControl x:Name="Items" ItemTemplate="{StaticResource StartupRow}"/>
                <TextBlock x:Name="EmptyText" Text="{l:T 'No startup apps found.'}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,40" Visibility="Collapsed"/>
                <Border Height="14"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
