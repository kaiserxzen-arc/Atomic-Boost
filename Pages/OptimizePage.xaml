<UserControl x:Class="Atomic.Pages.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Atomic.Core">
    <UserControl.Resources>
        <DataTemplate x:Key="ChipTpl">
            <Border CornerRadius="9" Padding="8,3" Margin="0,0,6,0" Background="#12FFFFFF" VerticalAlignment="Center">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontSize="10.5"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="TweakRow">
            <Border x:Name="Row" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Badge}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource Accent2}" FontSize="16"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,18,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipTpl}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <!-- for the curious: exactly which Windows values this switch changes -->
                            <TextBlock Style="{StaticResource Info}" Margin="2,0,0,0" ToolTip="{Binding ChangeText}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DisplayDesc}" Style="{StaticResource Desc2}" FontSize="12.5" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding Available}" Click="Toggle_Click"/>
                        <TextBlock x:Name="NA" Text="n/a" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="0.55"/>
                    <Setter TargetName="NA" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,20,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,6,16">
            <StackPanel>
                <TextBlock x:Name="SubTitle" Style="{StaticResource MutedText}" FontSize="11.5"/>
                <TextBlock Text="{l:U 'Windows Tweaks'}" Style="{StaticResource H1}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Border Style="{StaticResource PillBox}" Width="230" Height="38" CornerRadius="19" Padding="14,0" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="{l:T 'Search tweaks...'}" Foreground="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource Input}" Margin="9,0,0,0" TextChanged="Search_TextChanged"/>
                    </Grid>
                </Border>
                <Button Content="{l:T 'Revert all'}" Style="{StaticResource GhostBtn}" Margin="0,0,10,0" Click="RevertAll_Click"/>
                <Button Content="{l:T 'Apply recommended'}" Style="{StaticResource AccentBtn}" Click="ApplyRec_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource TabStrip}" CornerRadius="22" Padding="8,7,14,7" Margin="0,0,6,14">
            <StackPanel>
                <WrapPanel x:Name="CatTabs"/>
                <Rectangle Height="1" Fill="{StaticResource Line}" Margin="8,6,0,6"/>
                <Grid>
                    <!-- none chosen = everything; a click on the chosen one clears it -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:U 'Show only'}" Style="{StaticResource Caps}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="15,0,10,0"/>
                        <RadioButton Style="{StaticResource TabPill}" GroupName="Filter" Content="{l:T Recommended}" Tag="rec" Checked="Filter_Checked" PreviewMouseLeftButtonDown="Filter_Down"/>
                        <RadioButton Style="{StaticResource TabPill}" GroupName="Filter" Content="{l:T Applied}" Tag="on" Checked="Filter_Checked" PreviewMouseLeftButtonDown="Filter_Down"/>
                        <RadioButton Style="{StaticResource TabPill}" GroupName="Filter" Content="{l:T 'Not applied'}" Tag="off" Margin="0" Checked="Filter_Checked" PreviewMouseLeftButtonDown="Filter_Down"/>
                    </StackPanel>
                    <TextBlock x:Name="CountText" Foreground="{StaticResource Soft}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <ItemsControl x:Name="TweakList" ItemTemplate="{StaticResource TweakRow}"/>
                <TextBlock x:Name="EmptyText" Text="{l:T 'No tweaks match this filter.'}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,40" Visibility="Collapsed"/>
                <Border Height="14"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
