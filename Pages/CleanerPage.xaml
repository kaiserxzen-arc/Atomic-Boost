<UserControl x:Class="Atomic.Pages.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Atomic.Core">
    <UserControl.Resources>
        <DataTemplate x:Key="CleanRow">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding Checked, Mode=TwoWay}" Click="Tick_Click"/>
                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="14,0,0,0">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource Accent2}" FontSize="16"/>
                    </Border>
                    <StackPanel Grid.Column="2" Margin="14,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Desc}" Style="{StaticResource Desc2}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,20,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,6,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:T 'Free up disk space'}" Style="{StaticResource MutedText}" FontSize="11.5"/>
                    <TextBlock Style="{StaticResource Info}" FontSize="12" ToolTip="{l:T 'Free up disk space safely - files in use are always skipped'}"/>
                </StackPanel>
                <TextBlock Text="{l:U Cleaner}" Style="{StaticResource H1}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="{l:T 'Scan again'}" Style="{StaticResource GhostBtn}" Margin="0,0,10,0" Click="Scan_Click"/>
                <Button x:Name="BtnClean" Content="{l:T 'Clean selected'}" Style="{StaticResource AccentBtn}" Click="Clean_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,6,14" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:T 'SELECTED TO CLEAN'}" Style="{StaticResource Caps}"/>
                    <TextBlock x:Name="SelText" Text="-" Style="{StaticResource Num}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{l:T 'TOTAL FOUND'}" Style="{StaticResource Caps}"/>
                    <TextBlock x:Name="TotalText" Text="-" Style="{StaticResource Num}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:T 'SYSTEM DRIVE FREE'}" Style="{StaticResource Caps}"/>
                    <TextBlock x:Name="FreeText" Text="-" Style="{StaticResource Num}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <ItemsControl x:Name="Items" ItemTemplate="{StaticResource CleanRow}"/>
                <Border Height="14"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
