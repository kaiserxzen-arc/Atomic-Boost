<UserControl x:Class="Atomic.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Atomic.Controls"
             xmlns:l="clr-namespace:Atomic.Core">
    <UserControl.Resources>
        <DataTemplate x:Key="ProcRow">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft2}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1">
                    <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" Foreground="{StaticResource Accent2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MemText}" FontSize="13" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CpuText}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="236"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header: what is being watched, and the small live readouts -->
        <Grid Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SubTitle" Style="{StaticResource Caps}" Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource PillBox}" Height="38" CornerRadius="19" Padding="14,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Accent2}"/>
                        <TextBlock x:Name="NetText" Text="0 KB/s" Margin="8,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BatteryPill" Style="{StaticResource PillBox}" Height="38" CornerRadius="19" Padding="14,0" Margin="0,0,8,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE83F;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Accent2}"/>
                        <TextBlock x:Name="BatteryText" Margin="8,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Button x:Name="BtnRescan" Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="{l:T 'Re-check all settings'}" Click="BtnRescan_Click"/>
            </StackPanel>
        </Grid>

        <!-- the machine and the one big button, then the two live cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/><ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/><ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ScoreCard" Background="{StaticResource HeroBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="26" Padding="28,18,22,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="Title" Style="{StaticResource H1}" FontSize="30" TextWrapping="Wrap" LineHeight="34" LineStackingStrategy="BlockLineHeight" MaxHeight="69" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="GaugeLine1" Foreground="{StaticResource Soft}" FontSize="12.5"/>
                            <TextBlock x:Name="GaugeLine2" Foreground="{StaticResource Soft}" FontSize="12.5" Margin="5,0,0,0"/>
                            <TextBlock x:Name="BoostInfo" Style="{StaticResource Info}"/>
                        </StackPanel>
                        <Button x:Name="BtnOptimize" Style="{StaticResource BoostBtn}" Height="44" FontSize="13.5" Padding="16,0,20,0" HorizontalAlignment="Left" Margin="0,18,0,0" Content="{l:U 'One-Click Boost'}" Click="BtnOptimize_Click"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="204" VerticalAlignment="Center">
                        <TextBlock Text="{l:U 'Optimization score'}" Style="{StaticResource Caps}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <c:Gauge x:Name="ScoreGauge" Width="204" Height="122" Thickness="13" Margin="0,24,0,22"/>
                        <!-- inside the arc: a small bolt over the number -->
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Accent}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-2,0,0">
                                <TextBlock x:Name="ScoreVal" Text="0" Style="{StaticResource Num}" FontSize="34" FontWeight="Normal"/>
                                <TextBlock Text="%" Style="{StaticResource Num}" FontSize="34" FontWeight="Normal"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="ScoreSub" Foreground="{StaticResource Soft}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Tile}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="20,18,20,0">
                        <Border Width="38" Height="38" CornerRadius="19" Background="#F5B544">
                            <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Foreground="#1A1206" FontSize="16"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CPU" Style="{StaticResource Caps}"/>
                            <TextBlock x:Name="CpuName" FontSize="13" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="20,14,20,0">
                        <StackPanel>
                            <TextBlock x:Name="CpuVal" Text="0%" Style="{StaticResource Num}" FontSize="23"/>
                            <TextBlock x:Name="CpuSub" Style="{StaticResource MutedText}" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0">
                            <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Green}"><TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="8" Foreground="#06231A"/></Border>
                            <TextBlock x:Name="CpuPeak" Foreground="{StaticResource Green}" FontSize="11.5" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <c:Spark x:Name="CpuSpark" Grid.Row="2" Stroke="#3DDC97" Margin="0,4,0,12"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Tile}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="20,18,20,0">
                        <Border Width="38" Height="38" CornerRadius="19" Background="#6C7CFF">
                            <TextBlock Text="&#xE964;" Style="{StaticResource Icon}" Foreground="White" FontSize="16"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:T MEMORY}" Style="{StaticResource Caps}"/>
                            <TextBlock x:Name="RamName" FontSize="13" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="20,14,20,0">
                        <StackPanel>
                            <TextBlock x:Name="RamVal" Text="0%" Style="{StaticResource Num}" FontSize="23"/>
                            <TextBlock x:Name="RamSub" Style="{StaticResource MutedText}" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0">
                            <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Red}"><TextBlock Text="&#xE74B;" Style="{StaticResource Icon}" FontSize="8" Foreground="White"/></Border>
                            <TextBlock x:Name="RamFree" Foreground="{StaticResource Red}" FontSize="11.5" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <c:Spark x:Name="RamSpark" Grid.Row="2" Stroke="#FF5C5C" Margin="0,4,0,12"/>
                </Grid>
            </Border>
        </Grid>

        <!-- history + processes -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.85*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{l:T 'Performance History'}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Button Content="{l:T 'See all'}" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Click="SeeScanner_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource TabStrip}" Margin="0,16,0,14">
                        <UniformGrid Rows="1" x:Name="HistoryTabs">
                            <RadioButton Style="{StaticResource TabPill}" GroupName="Hist" Content="{l:T All}" Tag="" IsChecked="True" Checked="HistTab_Checked"/>
                            <RadioButton Style="{StaticResource TabPill}" GroupName="Hist" Content="CPU" Tag="CPU" Checked="HistTab_Checked"/>
                            <RadioButton Style="{StaticResource TabPill}" GroupName="Hist" Content="{l:T Memory}" Tag="Memory" Checked="HistTab_Checked"/>
                            <RadioButton Style="{StaticResource TabPill}" GroupName="Hist" Content="GPU" Tag="GPU" Checked="HistTab_Checked"/>
                            <RadioButton Style="{StaticResource TabPill}" GroupName="Hist" Content="{l:T Disk}" Tag="Disk" Checked="HistTab_Checked"/>
                        </UniformGrid>
                    </Border>
                    <c:MultiChart x:Name="History" Grid.Row="2"/>
                    <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                        <Border Style="{StaticResource PillBox}" Padding="12,7" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Series1}" VerticalAlignment="Center"/><TextBlock x:Name="LegCpu" Text="CPU  0%" FontSize="12" Margin="8,0,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource PillBox}" Padding="12,7" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Series2}" VerticalAlignment="Center"/><TextBlock x:Name="LegRam" FontSize="12" Margin="8,0,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource PillBox}" Padding="12,7" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Series3}" VerticalAlignment="Center"/><TextBlock x:Name="LegGpu" Text="GPU  0%" FontSize="12" Margin="8,0,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource PillBox}" Padding="12,7"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Series4}" VerticalAlignment="Center"/><TextBlock x:Name="LegDisk" FontSize="12" Margin="8,0,0,0"/></StackPanel></Border>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{l:T 'Top Processes'}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Button Content="{l:T 'See all'}" Style="{StaticResource GhostBtn}" HorizontalAlignment="Right" Click="TaskManager_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource TabStrip}" Margin="0,16,0,18">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="TabMem" Style="{StaticResource TabPill}" GroupName="Proc" Content="{l:T 'By Memory'}" IsChecked="True" Checked="ProcTab_Checked"/>
                            <RadioButton Style="{StaticResource TabPill}" GroupName="Proc" Content="{l:T 'By CPU'}" Checked="ProcTab_Checked"/>
                        </UniformGrid>
                    </Border>
                    <ItemsControl x:Name="ProcList" Grid.Row="2" ItemTemplate="{StaticResource ProcRow}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
