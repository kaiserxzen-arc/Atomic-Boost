<UserControl x:Class="Atomic.Pages.BoostPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Atomic.Core">
    <UserControl.Resources>
        <DataTemplate x:Key="ActionCard">
            <Border Style="{StaticResource Tile}" Padding="18,16" Margin="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Badge}">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource Accent2}" FontSize="16"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Content="{Binding Button}" Tag="{Binding Key}" Style="{StaticResource GhostBtn}" Padding="16,7" VerticalAlignment="Center" Click="Action_Click"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Desc}" Style="{StaticResource Desc2}" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Margin="28,20,12,0">
        <StackPanel>
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:T 'One press before you play'}" Style="{StaticResource MutedText}" FontSize="11.5"/>
                    <TextBlock Style="{StaticResource Info}" FontSize="12" ToolTip="{l:T 'Things you press yourself right before a game - for the automatic version see Auto Game Mode'}"/>
                </StackPanel>
                <TextBlock Text="{l:U 'Quick Boost'}" Style="{StaticResource H1}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- hero -->
            <Border x:Name="Hero" CornerRadius="26" Background="{StaticResource HeroBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="24,22" Margin="0,0,12,14">
                <Grid>
                    <StackPanel HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T 'Boost now'}" Style="{StaticResource H2}" FontSize="18"/>
                            <TextBlock Style="{StaticResource Info}" ToolTip="{l:T 'Closes common background apps (asks first), releases unused memory and flushes the DNS cache - one click before you start playing.'}"/>
                        </StackPanel>
                        <!-- what the button does, as three steps -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource PillBox}" Padding="12,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource Accent2}"/><TextBlock Text="{l:T 'Close background apps'}" FontSize="12" Margin="8,0,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource PillBox}" Padding="12,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE964;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Accent2}"/><TextBlock Text="{l:T 'Free up RAM'}" FontSize="12" Margin="8,0,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource PillBox}" Padding="12,7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Accent2}"/><TextBlock Text="{l:T 'Flush DNS cache'}" FontSize="12" Margin="8,0,0,0"/></StackPanel></Border>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="{l:U 'Boost now'}" Style="{StaticResource BoostBtn}" Height="44" FontSize="13.5" Padding="18,0,22,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BoostNow_Click"/>
                </Grid>
            </Border>

            <ItemsControl x:Name="Actions" ItemTemplate="{StaticResource ActionCard}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Height="18"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
