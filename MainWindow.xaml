<Window x:Class="Atomic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Atomic.Controls"
        xmlns:l="clr-namespace:Atomic.Core"
        Title="Atomic" Width="1320" Height="880" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- still picture: black with red light; the glass cards let it show through -->
        <c:Backdrop/>

        <Grid x:Name="Shell">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>   <!-- title strip: drag the window here -->
                <RowDefinition Height="Auto"/> <!-- bar with logo, pages and the boost button -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= title strip ================= -->
            <Grid Margin="30,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel x:Name="DeviceInfo" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <TextBlock x:Name="DeviceIcon" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Dim}"/>
                        <TextBlock x:Name="DeviceText" Style="{StaticResource Caps}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- shown only when the app cannot change anything -->
                    <StackPanel x:Name="ReadOnlyPill" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Yellow}"/>
                        <TextBlock Text="{l:U 'Read-only mode'}" Style="{StaticResource Caps}" Foreground="{StaticResource Yellow}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnLang" Style="{StaticResource ChromeBtn}" Width="Auto" Padding="0" Click="BtnLang_Click">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LangText" FontFamily="{StaticResource UiFont}" FontWeight="Medium" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="2,0,10,0">
                        <Button x:Name="BtnBell" Style="{StaticResource ChromeBtn}" FontSize="12" Content="&#xEA8F;" Click="BtnBell_Click" ToolTip="{l:T 'No restart needed'}"/>
                        <Ellipse x:Name="BellDot" Width="8" Height="8" Fill="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Style="{StaticResource ChromeBtn}" Content="&#xE921;" Click="Min_Click"/>
                    <Button Style="{StaticResource ChromeBtn}" Content="&#xE922;" Click="Max_Click" x:Name="BtnMax"/>
                    <Button x:Name="BtnClose" Style="{StaticResource ChromeBtn}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ================= bar: logo, pages, boost ================= -->
            <Border Grid.Row="1" Margin="22,2,22,0" Padding="12,9,9,9" CornerRadius="31" Background="{StaticResource TopPill}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="LogoImage" Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                        <TextBlock Text="ATOMIC" FontFamily="{StaticResource HeadFont}" FontSize="19" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="Nav" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource NavTab}" Content="{l:U 'Dashboard'}" ToolTip="{l:T 'Live load and score'}" CommandParameter="dashboard" AutomationProperties.AutomationId="Nav_dashboard" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavTab}" Content="{l:U 'Tweaks'}" ToolTip="{l:T 'One switch per setting'}" CommandParameter="optimize" AutomationProperties.AutomationId="Nav_optimize" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavTab}" Content="{l:U 'Cleaner'}" ToolTip="{l:T 'Free up disk space'}" CommandParameter="cleaner" AutomationProperties.AutomationId="Nav_cleaner" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavTab}" Content="{l:U 'Startup'}" ToolTip="{l:T 'What starts with Windows'}" CommandParameter="startup" AutomationProperties.AutomationId="Nav_startup" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavTab}" Content="{l:U 'Game Mode'}" ToolTip="{l:T 'Runs by itself in games'}" CommandParameter="gamemode" AutomationProperties.AutomationId="Nav_gamemode" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavTab}" Content="{l:U 'Quick Boost'}" ToolTip="{l:T 'One press before you play'}" CommandParameter="boost" AutomationProperties.AutomationId="Nav_boost" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavTab}" Content="{l:U 'Specs'}" ToolTip="{l:T 'Hardware, drives, health check'}" CommandParameter="scanner" AutomationProperties.AutomationId="Nav_scanner" Checked="Nav_Checked"/>
                        <RadioButton Style="{StaticResource NavTab}" Content="{l:U 'Settings'}" ToolTip="{l:T 'Language, backups, undo'}" CommandParameter="settings" AutomationProperties.AutomationId="Nav_settings" Margin="0" Checked="Nav_Checked"/>
                    </StackPanel>

                    <Button x:Name="BtnBoost" Grid.Column="2" Style="{StaticResource BoostBtn}" Height="38" FontSize="12" VerticalAlignment="Center" Margin="0,0,3,0" Content="{l:U 'One-Click Boost'}" Click="BtnBoost_Click"/>
                </Grid>
            </Border>

            <Grid x:Name="PageHost" Grid.Row="2"/>
        </Grid>

        <!-- toast -->
        <Border x:Name="ToastBox" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentLine}" BorderThickness="1" CornerRadius="18" Padding="16,11" MaxWidth="640">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastDot" Width="9" Height="9" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" Margin="11,0,0,0" TextWrapping="Wrap" MaxWidth="580" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- busy overlay -->
        <Grid x:Name="BusyOverlay" Background="{StaticResource Overlay}" Visibility="Collapsed">
            <Border x:Name="BusyCard" Style="{StaticResource Card}" Background="{StaticResource Panel}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,28">
                <StackPanel>
                    <Grid Width="48" Height="48" HorizontalAlignment="Center">
                        <Ellipse StrokeThickness="4" Stroke="#14FFFFFF"/>
                        <Ellipse StrokeThickness="4" Stroke="{StaticResource AccentGrad}" StrokeDashArray="7 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="Spin"/></Ellipse.RenderTransform>
                            <Ellipse.Effect><DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="BusyTitle" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock x:Name="BusyText" Style="{StaticResource MutedText}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- confirm dialog -->
        <Grid x:Name="DialogOverlay" Background="{StaticResource Overlay}" Visibility="Collapsed">
            <Border x:Name="DialogCard" Style="{StaticResource Card}" Background="{StaticResource Panel}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,26">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}" FontSize="17" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DialogText" Style="{StaticResource MutedText}" FontSize="13" LineHeight="20" Margin="0,12,0,22"/>
                    <!-- only the "close or keep running" question uses the tick box and the middle button -->
                    <StackPanel x:Name="DialogRememberRow" Orientation="Horizontal" Margin="0,0,0,18" Visibility="Collapsed">
                        <CheckBox x:Name="DialogRemember" Style="{StaticResource Tick}"/>
                        <TextBlock Text="{l:T 'Remember my choice'}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Soft}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogCancel" Content="{l:T Cancel}" Style="{StaticResource GhostBtn}" Click="DialogCancel_Click"/>
                        <Button x:Name="DialogAlt" Style="{StaticResource GhostBtn}" Margin="10,0,0,0" Visibility="Collapsed" Click="DialogAlt_Click"/>
                        <Button x:Name="DialogOk" Style="{StaticResource AccentBtn}" Margin="10,0,0,0" Click="DialogOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
